# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the keys you actually have.
# .env is git-ignored - NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- results / labels -------------------------------------------------------
# https://www.football-data.org/client/register  (free tier, top leagues)
FOOTBALL_DATA_ORG_KEY=

# https://www.api-football.com/  (free tier: 100 requests/day)
API_FOOTBALL_KEY=

# --- odds -------------------------------------------------------------------
# https://oddspapi.io/  (free tier: 250 requests/month per their own article)
ODDSPAPI_KEY=

# --- odds AND results in one API (recommended) ------------------------------
# https://5dollarfootballapi.com/
# Free tier: top-5 leagues, bet365 odds, last 3 months, 60 requests/hour.
# Pro ($5/mo) covers 137 competitions with 12 months of history.
FIVE_DOLLAR_FOOTBALL_API_KEY=

# Bookmaker slug for that API. bet365 ships with every plan; pinnacle and the
# other 18 bookmakers need the Ultra plan.
FB_BOOKMAKER_SLUG=bet365

# ---------------------------------------------------------------------------
# Domain settings
# ---------------------------------------------------------------------------
FB_LEAGUE=EPL
FB_BOOKMAKER=Pinnacle
FB_SEASON=2025

# Model / staking
FB_EDGE_THRESHOLD=0.06
FB_BLACKLIST_MARKETS=OU_over
# FB_ALLOWED_MARKETS=AH_dog,OU_under
FB_STAKE=1.0
FB_MIN_TRAIN=40
FB_TRAIN_RATIO=0.8
FB_REFIT_EVERY=1
FB_SEED=42

# Network politeness (seconds between outbound requests).
# 5DollarFootballAPI allows 20 requests/minute even on the hourly plans, so
# anything below ~3.1s will hit the per-minute burst limit.
FB_REQUEST_DELAY=3.2
FB_HTTP_TIMEOUT=30
FB_HTTP_RETRIES=3

# How long a stored raw payload may be reused before it is fetched again (hours).
# Without this, a season fetched once would be replayed forever with a fresh
# timestamp attached.
FB_CACHE_MAX_AGE_HOURS=6

# ---------------------------------------------------------------------------
# Telegram notifications / bot (telegram_notify.py, telegram_bot.py)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather and paste the token here. NEVER commit it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to command the bot and receive messages.
# Message the bot once; it replies with your chat id so you can paste it here.
TELEGRAM_ALLOWED_CHAT_ID=
# Optional one-way notification target; falls back to the allowed chat id.
# TELEGRAM_CHAT_ID=
