{
  "manifest_version": 3,
  "name": "KUBET Quant Auto-Bet Bridge",
  "version": "1.2.2",
  "description": "Bridge connecting Cook45 Quant AI to KUBET for Automated Betting",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.hdfr985.net/*",
    "*://*.heratven.net/*",
    "*://*.cuu19c.net/*",
    "*://*.jjsskktt.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hdfr985.net/*",
        "*://*.heratven.net/*",
        "*://*.cuu19c.net/*",
        "*://*.jjsskktt.com/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["hud.css"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KUBET Quant Auto-Bet Bridge"
  }
}
